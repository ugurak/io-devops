# Kopyala: cp .env.example .env  — bu dosya repoya girmez.
# Sunucu yolu örn: /var/istanbulofset/dev-ops/.env

# --- Ağ / domain (dev ortamı) ---
SITE_DOMAIN=dev.istanbulofset.net
API_DOMAIN=api.istanbulofset.net
LETSENCRYPT_EMAIL=admin@istanbulofset.net

# Monorepo kökü (local-push build bağlamı)
APP_ROOT=/var/istanbulofset

DOCKER_REGISTRY=registry.veraius.com
IMAGE_TAG=latest
REGISTRY_USER=admin
REGISTRY_PASSWORD=

# --- Postgres ---
POSTGRES_DB=istanbulofset
POSTGRES_USER=istanbulofset
POSTGRES_PASSWORD=          # openssl rand -base64 32

# --- Redis ---
REDIS_PASSWORD=             # openssl rand -base64 24

# --- MinIO ---
MINIO_ROOT_USER=istanbulofset
MINIO_ROOT_PASSWORD=        # openssl rand -base64 32
MINIO_BUCKET=istanbulofset-uploads

# --- Elasticsearch / Kibana ---
ELASTIC_PASSWORD=           # openssl rand -base64 24
# ES container 2G → heap ~1G (OS/nginx için ~1G boş bırakıldı)
ES_JAVA_OPTS="-Xms1g -Xmx1g"

# --- API ---
JWT_SIGNING_KEY=            # openssl rand -base64 48 (en az 32 karakter)
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=     # ilk girişten sonra değiştirip boşaltın

PAYMENT_PROVIDER=iyzico
IYZICO_BASE_URL=https://api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

CARGO_PROVIDER=manual
CARGO_COMPANY="Yurtiçi Kargo"
EINVOICE_PROVIDER=manual

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=StartTls
SMTP_FROM="İstanbul Ofset <siparis@istanbulofset.net>"

OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Web ---
ANTHROPIC_API_KEY=
INDEXNOW_KEY=
ALLOW_AI_TRAINING=true
APPLE_TEAM_ID=
IOS_BUNDLE_ID=net.istanbulofset.app
ANDROID_PACKAGE_NAME=net.istanbulofset.app
ANDROID_SHA256_CERT_FINGERPRINTS=

# --- Web Push (VAPID) ---
# Üretmek: npx web-push generate-vapid-keys
# Public key API + (isteğe bağlı) web image build-arg NEXT_PUBLIC_VAPID_PUBLIC_KEY
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:destek@istanbulofset.net

# --- Yedek ---
BACKUP_RETENTION_DAYS=14
