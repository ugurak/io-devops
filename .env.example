# Kopyala: cp .env.example .env  — bu dosya repoya girmez.
# Sunucu yolu örn: /var/istanbulofset/dev-ops/.env

# --- Ağ / domain (dev ortamı) ---
SITE_DOMAIN=test.istanbulofset.net
API_DOMAIN=api.istanbulofset.net
LETSENCRYPT_EMAIL=admin@istanbulofset.net

# Monorepo kökü (local-push build bağlamı)
APP_ROOT=/var/istanbulofset

DOCKER_REGISTRY=registry.veraius.com
IMAGE_TAG=latest
REGISTRY_USER=admin
REGISTRY_PASSWORD=

# --- Postgres ---
POSTGRES_DB=istanbulofset
POSTGRES_USER=istanbulofset
POSTGRES_PASSWORD=          # openssl rand -base64 32

# --- Redis ---
REDIS_PASSWORD=             # openssl rand -base64 24

# --- MinIO ---
MINIO_ROOT_USER=istanbulofset
MINIO_ROOT_PASSWORD=        # openssl rand -base64 32
MINIO_BUCKET=istanbulofset-uploads
# API'nin yalnızca bucket'a yetkili kullanıcısı (deploy.sh → minio-setup oluşturur). Boşsa API root ile bağlanır.
MINIO_APP_USER=istanbulofset-app
MINIO_APP_PASSWORD=     # openssl rand -base64 32

# --- Elasticsearch / Kibana ---
ELASTIC_PASSWORD=           # openssl rand -base64 24
SEARCH_ES_PASSWORD=         # İsteğe bağlı: web aramasının kısıtlı ES kullanıcısı (boşsa ELASTIC_PASSWORD)
LOGSTASH_ES_PASSWORD=       # İsteğe bağlı: Logstash'in kısıtlı ES kullanıcısı (boşsa ELASTIC_PASSWORD)
# ES container 2G → heap ~1G (OS/nginx için ~1G boş bırakıldı)
ES_JAVA_OPTS="-Xms1g -Xmx1g"

# --- API ---
JWT_SIGNING_KEY=            # openssl rand -base64 48 (en az 32 karakter)
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=     # ilk girişten sonra değiştirip boşaltın

PAYMENT_PROVIDER=iyzico
IYZICO_BASE_URL=https://api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

CARGO_PROVIDER=manual           # mock | manual | yurtici
CARGO_COMPANY="Yurtiçi Kargo"
YURTICI_USERNAME=                # Yurtiçi Kargo web servis kullanıcı adı
YURTICI_PASSWORD=                # Yurtiçi Kargo web servis şifresi
YURTICI_BASE_URL=https://ws.yurticikargo.com/KOPSWebServices/ShippingOrderDispatcherServices   # test: http://testwebservices.yurticikargo.com:9090/KOPSWebServices/ShippingOrderDispatcherServices
EINVOICE_PROVIDER=manual

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=StartTls
SMTP_FROM="İstanbul Ofset <siparis@istanbulofset.net>"
SMTP_REPLY_TO=              # Müşteri yanıtlarının gideceği adres (ör. destek@istanbulofset.net); boşsa gönderen adres
# Ayrı gönderen hesaplar (aynı SMTP sunucusu). Kullanıcı boşsa ileti varsayılan hesapla gider.
SMTP_NEWSLETTER_USER=       # bülten onayı, sepet hatırlatma (ör. bulten@istanbulofset.net)
SMTP_NEWSLETTER_PASSWORD=
SMTP_NEWSLETTER_FROM=       # ör. İstanbul Ofset <bulten@istanbulofset.net>; boşsa kullanıcı adı
SMTP_SUPPORT_USER=          # destek talebi yanıtları (ör. destek@istanbulofset.net)
SMTP_SUPPORT_PASSWORD=
SMTP_SUPPORT_FROM=

# Boş bırakın: EXTRA_STACKS'e göre _lib.sh doldurur (observability → http://otel-collector:4317)
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Web ---
ANTHROPIC_API_KEY=
INDEXNOW_KEY=
ALLOW_AI_TRAINING=true
APPLE_TEAM_ID=
IOS_BUNDLE_ID=net.istanbulofset.app
ANDROID_PACKAGE_NAME=net.istanbulofset.app
ANDROID_SHA256_CERT_FINGERPRINTS=

# --- Web Push (VAPID) ---
# Üretmek: npx web-push generate-vapid-keys
# Public key API + (isteğe bağlı) web image build-arg NEXT_PUBLIC_VAPID_PUBLIC_KEY
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=mailto:destek@istanbulofset.net

# --- İzleme / isteğe bağlı yığınlar ---
# Gatus (çalışma süresi izleme) her zaman açık. Ek yığınlar (boşlukla): clamav glitchtip observability
#   clamav        ~1,5G  yüklenen dosyalarda virüs taraması (API Uploads__ClamAv=clamav:3310)
#   glitchtip     ~0,5G  hata takibi (API + web; DSN'ler GLITCHTIP_*_KEY'den üretilir)
#   observability ~0,7G  OTel Collector + Jaeger + Prometheus + Grafana (API izleri/metrikleri)
EXTRA_STACKS="glitchtip observability"
ALERT_EMAIL=                # kesinti e-postası alıcısı; boşsa ADMIN_EMAIL
ALERT_FROM=                 # boşsa izleme@SITE_DOMAIN
KIBANA_SYSTEM_PASSWORD=     # boşsa ELASTIC_PASSWORD (Kibana kibana_system kullanıcısıyla bağlanır)
JAEGER_PUBLIC_URL=          # Kibana'da trace_id → iz bağlantısı (ör. SSH tüneliyle http://localhost:16686)
GRAFANA_ADMIN_PASSWORD=     # openssl rand -base64 24
GLITCHTIP_SECRET_KEY=       # openssl rand -base64 48
GLITCHTIP_ADMIN_EMAIL=      # boşsa ADMIN_EMAIL
GLITCHTIP_ADMIN_PASSWORD=   # openssl rand -base64 24
GLITCHTIP_API_KEY=          # uuidgen (API projesi DSN anahtarı)
GLITCHTIP_WEB_KEY=          # uuidgen (Web projesi DSN anahtarı)
GLITCHTIP_HOST=             # isteğe bağlı: arayüzü nginx-proxy ile yayınla (ör. hata.istanbulofset.net)
GLITCHTIP_EMAIL_URL=        # isteğe bağlı: smtp://kullanici:sifre@sunucu:587
CLAMAV_ADDRESS=             # boş bırakın: clamav açıksa clamav:3310

# --- Yedek ---
BACKUP_RETENTION_DAYS=14
DISK_ALERT_PERCENT=85        # disk bu yüzdeyi aşınca Gatus e-posta atar (backup.sh günde bir ölçer)
LOG_RETENTION_DAYS=30        # Elasticsearch günlük dizinleri bu kadar gün sonra silinir
BACKUP_HEARTBEAT_TOKEN=     # İsteğe bağlı: yedek sinyali için Gatus belirteci (boşsa POSTGRES_PASSWORD)

# Sunucu dışı şifreli yedek (backup/offsite.sh): pg_dump + MinIO medyası. Bucket boşsa kapalı.
# Ör. Cloudflare R2: ENDPOINT=https://<hesap-id>.r2.cloudflarestorage.com, REGION=auto, PROVIDER=Cloudflare
# Anahtar yalnızca bu bucket'a yazma/okuma yetkili olsun.
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_BUCKET=
OFFSITE_S3_ACCESS_KEY=
OFFSITE_S3_SECRET_KEY=
OFFSITE_S3_REGION=auto
OFFSITE_S3_PROVIDER=Other
OFFSITE_ENCRYPTION_PASSWORD=   # openssl rand -base64 32 — parola yöneticisine de kaydedin; kaybolursa yedekler açılamaz
OFFSITE_RETENTION_DAYS=30
OFFSITE_HEARTBEAT_URL=         # isteğe bağlı: healthchecks.io vb. ping adresi; günlük yedek gelmezse dışarıdan uyarı

# Personel paneli MFA zorunluluğu (prod’da MFA kurulunca true)
REQUIRE_STAFF_MFA=false
